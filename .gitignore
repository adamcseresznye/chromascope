# Mac stuff:
.DS_Store

# trunk output folder
dist

# Rust compile target directories:
target
target_ra
target_wasm

# https://github.com/lycheeverse/lychee
.lycheecache

# data and target folder and their content
data/
target/
__pycache__/

# The maintainer's own notes, plans and evidence stay on disk and out of the repository. The rule
# is anchored with a slash: it covers the root folder only, so website/ and its pages are tracked.
/docs/

# The built website
/website/site/

# Mass spectrometry data: never commit acquisitions by accident. Patterns match at any depth;
# a plain ".mzML" would only match a file with exactly that name. The small authored fixtures
# are re-included below (Git ignores new files there unless they match a "!" rule).
*.mzML
*.mzml
*.mzML.gz
*.mzml.gz
*.mzXML
*.mzxml
*.raw
*.RAW
*.wiff
*.wiff2
*.wiff.scan
# Vendor "directory" data (Agilent .d, Waters .raw, Bruker .d)
*.d/
!test_file/*.mzML
!tests/fixtures/**/*.mzML
